<h2><%= h(@memo.title) %></h2>

<p><%= h(@memo.content) %></p>

<a href="/memos/<%= @memo.id %>/edit">変更</a>

<form action="/memos/<%= @memo.id %>" method="post" style="display: inline;">
  <input type="hidden" name="_method" value="delete">
  <button type="submit" onclick="return confirm('本当に削除しますか？')">削除</button>
</form>

<a href="/memos">戻る</a>
